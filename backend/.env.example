# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=development
APP_ENV=development
PORT=5001
REQUEST_BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:3000
LOG_FORMAT=json

# Business Configuration
FARE=10

# Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Frontend URL (used for invite links in email)
FRONTEND_URL=http://localhost:3000

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_AUTHENTICATED=600
RATE_LIMIT_PAYMENTS=60
RATE_LIMIT_SEARCH=120

# Feature flags
FEATURE_EMAIL=false
FEATURE_PUSH=false
FEATURE_BACKUPS=true
FEATURE_JOBS=true
FEATURE_METRICS=true
FEATURE_REALTIME=true

# Provider selections
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp|ethereal|console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=BusQR <noreply@example.com>
PUSH_PROVIDER=console
STORAGE_PROVIDER=local
MAPS_PROVIDER=google_js
PAYMENT_PROVIDER=razorpay_foundation

# Razorpay production/test checkout
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=never_commit_real_secret
RAZORPAY_WEBHOOK_SECRET=never_commit_webhook_secret
RAZORPAY_MODE=test

# Clerk webhooks (Svix signing secret from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
